rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user (guest or Google) can only read and write their own data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Guardian view: a read-only progress snapshot opened from an unguessable link.
    // Anyone with the link can read that one document (no listing); only its owner can write it.
    match /guardians/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
