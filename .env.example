# Copy to .env.local to point the app at your own Firebase project (Project settings > Your apps > web).
# The committed .env holds the config for the hosted demo project.
# These identify your Firebase project; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local dev only. Put these in .env.development.local (never .env.local, which production builds also read).
# Either set a debug token registered under App Check > Manage debug tokens,
# or set VITE_APPCHECK_DEBUG=true and register the token Chrome prints in the console.
VITE_APPCHECK_DEBUG_TOKEN=
VITE_APPCHECK_DEBUG=
