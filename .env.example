# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (web).
# These identify your Firebase project; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For local dev: set to "true" and register the debug token printed in the console.
VITE_APPCHECK_DEBUG=true
